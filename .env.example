# SkillTrack Environment Configuration (SIH26135)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
FLASK_ENV=production
FLASK_DEBUG=False
PORT=5000

# Database Configuration
# Set USE_SQLITE=true for zero-setup SQLite deployment with synthetic demo data
USE_SQLITE=true
SQLITE_DB_PATH=database/skilltrack.db

# Cloud Managed Relational Database (Optional - active when USE_SQLITE=false)
# DATABASE_URL=mysql://user:password@hostname:3306/dbname
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=skilltrack_db

# Prototype Outcome Score Formula Weights (Sum = 100)
WEIGHT_EMPLOYMENT=30
WEIGHT_RETENTION=25
WEIGHT_RELEVANCE=20
WEIGHT_SALARY_GROWTH=15
WEIGHT_EMPLOYER_FEEDBACK=10
